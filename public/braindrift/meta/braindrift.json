  "simulation": {
   "upward_shift": {
    "A_mm": 2.52,
    "formula": "u_up(x) = A * f * h(x), pointing up (minus array axis 1 of the LIA crop)",
    "taper": "h = 3t^2 - 2t^3, t = (height above ventricle centroid) / (height of the brain's highest point above the centroid), clipped to [0, 1]: zero at and below the ventricles, full at the top",
    "source": "PNAS2026"
   },
   "ventricle_swelling": {
    "growth_pct_at_f1": 10.7,
    "formula": "u_v(x) = s * (x - c) * exp(-D^2 / (2 * 8^2)), c = ventricle centroid, D = mm to the nearest ventricle voxel (0 inside)",
    "s_search": "bisection, 30 halvings of s in [0.0, 0.2] per brain and frame, on the total field u_up + u_v",
    "injected_truth": "partial-volume sum of the trilinearly warped FreeSurfer ventricle mask",
    "source": "Roberts2019"
   },
   "warp": "post(x) = pre(x - u(x)); torch grid_sample, align_corners=True; trilinear for the image (rounded to uint8), trilinear partial volume for the injected ventricle truth",
   "our_modelling_choices": [
    "the smoothstep taper of the upward shift",
    "using the largest regional rise (supplementary motor cortex, 2.52 mm) as the peak at the vertex",
    "the 8 mm Gaussian width of the swelling field",
    "the intermediate frames f = 0.25, 0.5, 0.75 (illustration only)"
   ],
   "two_cohorts": "the 2.52 mm rise comes from the one-year crew (PNAS 2026), the +10.7% from the long-duration mean (Roberts 2019); the f = 1 frame is never one measured astronaut",
   "not_simulated": "no backward shift (PNAS 2026 reports one; act_2.md gives no magnitude)",
   "alignment": "the simulated pair is aligned by construction; real pre/post scans would first need skull alignment, which is not built (and the skull-stripped crops have no skull)"
  },
  "citations": [
