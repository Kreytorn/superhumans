  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "org.superhumans.console",
    "productName": "SuperHumans",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "electronDist": "node_modules/electron/dist",
    "electronLanguages": [
      "en-US"
    ],
    "asar": true,
    "win": {
      "target": [
        "dir",
        "zip"
      ]
    }
  }
