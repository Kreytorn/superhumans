{
  "name": "superhumans",
  "private": true,
  "version": "0.1.0",
  "description": "SuperHumans: crew-health console for astronauts. Six in-browser AI modules, each ending in what to do next. NASA Space Apps 2026 Istanbul.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "desktop": "vite build && electron .",
    "desktop:kiosk": "electron . --kiosk",
    "pack": "vite build && electron-builder --win dir zip"
  },
